# Modern server settings. The Windows 98SE client connects over LAN HTTP.
HOST=0.0.0.0
PORT=3084
AI_MODE=local
# SAVE_DIR=V:/AssholeGPT/data/saves
# PUBLIC_ORIGIN=http://island.example
# COOKIE_SECURE=false

# Optional compatible model provider; no credentials are needed for local bots.
# AI_MODE=api
# AI_URL=https://YOUR-PROVIDER/v1/chat/completions
# AI_MODEL=YOUR-MODEL
# AI_API_FORMAT=chat
# AI_TOKEN_FILE=C:/private/island-token.txt
# AI_TIMEOUT_MS=60000

# Optional existing Codex CLI, authenticated as the server account.
# AI_MODE=codex
# AI_MODEL=default
# CODEX_COMMAND=codex
# CODEX_JS_PATH=C:/path/to/node_modules/@openai/codex/bin/codex.js
# AI_TIMEOUT_MS=180000
